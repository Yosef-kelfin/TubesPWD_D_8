# Folder upload foto laporan.
# Blokir eksekusi skrip dan daftar direktori, tetapi tetap izinkan gambar.
Options -Indexes -ExecCGI

<FilesMatch "\.(php|php[0-9]|phtml|phar|cgi|pl|py|sh|exe|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
